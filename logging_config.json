{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s | %(levelname)s | %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "default",
      "filename": ".server.log",
      "encoding": "utf-8",
      "maxBytes": 10485760,
      "backupCount": 3
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["file"],
      "level": "INFO",
      "propagate": false
    }
  }
}
